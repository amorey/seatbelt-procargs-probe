;; deny.sb: control.sb plus the two rules discussed in
;; anthropics/sandbox-runtime#160, placed where that thread places them.
(version 1)
(deny default)
(allow process-exec)
(allow process-fork)
(allow file-read*)
(allow file-write* (literal "/dev/null"))
(allow signal (target same-sandbox))
(deny process-info* (target others))
(allow process-info* (target same-sandbox))
(allow sysctl-read)
(deny sysctl-read (sysctl-name-prefix "kern.procargs"))
